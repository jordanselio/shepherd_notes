<?xml version="1.0" encoding="utf-8"?>
<!-- Shared by the TODAY widget's (non-interactive) preview rows and the
     TO-DO widget's (interactive) rows. In the TO-DO widget, todo_row_checkbox
     gets its own completion PendingIntent and todo_row_content gets the
     "open To-do tab" one; in the TODAY widget only todo_row_root gets a
     PendingIntent (open To-do tab) and the checkbox is inert. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/todo_row_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="34dp"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <FrameLayout
        android:id="@+id/todo_row_checkbox"
        android:layout_width="34dp"
        android:layout_height="34dp">
        <FrameLayout
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:background="@drawable/widget_checkbox_ring" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/todo_row_content"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="match_parent"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/todo_row_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="14sp"
            android:textColor="@color/widget_text"
            tools:text="Text Daniel about Thursday" />
    </LinearLayout>

</LinearLayout>
