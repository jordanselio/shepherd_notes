<?xml version="1.0" encoding="utf-8"?>
<!-- widgetCategory includes "keyguard" for completeness, but Android has
     not hosted app widgets on the actual lock screen since 5.0 (API 21);
     in practice this places on the home screen like any other widget. See
     the implementation report for what the test device supports. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_lock_today"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen|keyguard"
    android:description="@string/widget_lock_today_description" />
